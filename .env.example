# Base de datos MongoDB (Atlas o local).
DATABASE_URL=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/uptask_mern

# URL del frontend, para CORS y para los enlaces de los correos.
FRONTEND_URL=http://localhost:5173

# Envío de correo (confirmación de cuenta y recuperación de contraseña).
# Con un inbox de pruebas de mailtrap.io basta en desarrollo.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Contraseña inicial con la que se dan de alta las cuentas del equipo
# (npm run seed:team) y con la que entran las verificaciones.
# Cada integrante debería cambiarla al entrar por primera vez.
TEAM_SEED_PASSWORD=

# Firma de los tokens de sesión. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
